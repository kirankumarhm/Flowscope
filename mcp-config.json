{
  "description": "Model Context Protocol (MCP) client configurations for FlowScope. Replace <FLOWSCOPE_HOME> with the absolute path of your FlowScope checkout.",
  "transports": {
    "stdio": {
      "name": "flowscope",
      "command": "java",
      "args": [
        "-jar",
        "<FLOWSCOPE_HOME>/backend/target/flowscope-web.jar",
        "--mcp"
      ]
    },
    "streamable_http": {
      "name": "flowscope",
      "url": "http://127.0.0.1:8080/mcp"
    },
    "sse_legacy": {
      "name": "flowscope",
      "url": "http://127.0.0.1:8080/mcp/sse"
    }
  },
  "claude_desktop_config_example": {
    "mcpServers": {
      "flowscope": {
        "command": "java",
        "args": [
          "-jar",
          "<FLOWSCOPE_HOME>/backend/target/flowscope-web.jar",
          "--mcp"
        ]
      }
    }
  },
  "cursor_or_antigravity_mcp_config_example": {
    "mcpServers": {
      "flowscope": {
        "url": "http://127.0.0.1:8080/mcp"
      }
    }
  }
}
